<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # If an existing asset or directory is requested go to it directly
  RewriteCond %{REQUEST_FILENAME} -s [OR]
  RewriteCond %{REQUEST_FILENAME} -l [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^.*$ - [NC,L]

  # Redirect social media bot and sharing crawler requests to the Spring Boot share endpoint
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Pinterest|WhatsApp|TelegramBot|Slackbot) [NC]
  RewriteRule ^article/([^/]+)$ /api/articles/share/$1 [R=302,L]

  # Redirect all other URLs to index.html for Angular routing
  RewriteRule ^(.*)$ index.html [NC,L]
</IfModule>
